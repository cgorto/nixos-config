# Ghostty config — see `ghostty +show-config --default --docs` for all options.

# Font.
# JetBrains Mono is installed in ~/.local/share/fonts. If you swap to Berkeley
# Mono later, just change the family name here.
font-family = JetBrainsMono Nerd Font
font-size = 12

# Theme. Run `ghostty +list-themes` to browse — names are case-sensitive.
# Other dark picks: `Tokyo Night`, `GruvboxDarkHard`, `rose-pine`, `Dracula+`.
theme = Catppuccin Mocha

# Window chrome. GTK on Wayland looks cleanest with the native titlebar off and
# tabs on top.
gtk-titlebar = false
gtk-tabs-location = top
gtk-wide-tabs = false
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# Behavior.
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
scrollback-limit = 100000

# Cursor.
cursor-style = block
cursor-style-blink = false

# Shell integration is auto-detected; keep this on for nicer prompt jumping etc.
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Default keybinds:
#   ctrl+shift+t        new tab
#   ctrl+shift+w        close tab/surface
#   ctrl+page_up/down   prev/next tab
#   ctrl+shift+c/v      copy/paste
#   ctrl+shift+o        new split (right)
#   ctrl+shift+e        new split (down)
#   ctrl+shift+enter    zoom current split
#   ctrl+alt+arrows     focus split
#   super+ctrl+[ / ]    cycle splits
